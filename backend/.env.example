# Flask configuration
DEBUG=True
SECRET_KEY=your-secret-key-here

# Database configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobapply

# JWT configuration
JWT_SECRET_KEY=jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES=3600

# File upload configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Email configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=noreply@jobapply.com

# Environment
FLASK_ENV=development

# Optional scaled services
ELASTICSEARCH_URL=http://localhost:9200
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=jobapply-resumes
AWS_REGION=us-east-1
VIDEO_UPLOAD_FOLDER=uploads/videos
VIDEO_MAX_DURATION=120
VIDEO_MAX_SIZE=50
